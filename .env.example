# ── Required ──────────────────────────────────────────────────────────
# Database — SQLite for local dev. For Vercel/Postgres, change prisma/schema.prisma
# provider to "postgresql" and set DATABASE_URL to your Postgres connection string.
DATABASE_URL="file:./dev.db"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-random-32-byte-base64-string"
NEXTAUTH_URL="http://localhost:3000"

# ── AI Provider API Keys (at least one required) ─────────────────────
# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# HuggingFace — free serverless inference (https://huggingface.co/settings/tokens)
HF_TOKEN=""
HF_BASE_URL="https://router.huggingface.co/v1"

# NVIDIA NIM — optional (https://build.nvidia.com)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# ── Per-agent model assignment (all routed through OpenRouter) ────────
# Override any of these to use different models. Format: "provider:model-id"
# Supported providers: openrouter, huggingface, nvidia
MODEL_FIX_SYNTHESIZER="openrouter:deepseek/deepseek-chat"
MODEL_SQLI_HUNTER="openrouter:deepseek/deepseek-chat"
MODEL_XSS_DEFENDER="openrouter:qwen/qwen3-coder"
MODEL_SECRET_SENTINEL="openrouter:deepseek/deepseek-chat"
MODEL_AUTH_CRYPTO="openrouter:qwen/qwen3-coder"
MODEL_SSRF_PATH="openrouter:deepseek/deepseek-chat"
MODEL_DEPENDENCY_AUDITOR="openrouter:deepseek/deepseek-chat"

# Utility models
MODEL_REASONING="openrouter:deepseek/deepseek-chat"
MODEL_CODE="openrouter:qwen/qwen3-coder"
MODEL_FAST="openrouter:deepseek/deepseek-chat"

# ── Optional: GitHub OAuth ────────────────────────────────────────────
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Optional: GitHub PAT for private repos ────────────────────────────
GITHUB_DEFAULT_TOKEN=""

# ── App ────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
